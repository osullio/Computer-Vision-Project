{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with MSVC and OpenCV (x64)",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/EHsc",
                "/Zi",
                "/Fe:${fileDirname}\\output\\${fileBasenameNoExtension}.exe",
                "${file}",
                "/I", "C:\\opencv\\build\\include",
                "/I", "C:\\opencv\\build\\x64\\vc16\\include",
                "/link",
                "/MACHINE:X64",  
                "/LIBPATH:C:\\opencv\\build\\x64\\vc16\\lib",
                "opencv_world4120.lib",
                "/DEBUG"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build with MSVC (x64) and OpenCV"
        }
    ]
}
